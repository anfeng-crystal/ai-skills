.kdcc-root {
  box-sizing: border-box;
  display: grid;
  gap: 8px;
  min-height: 96px;
  padding: 12px;
  color: #212121;
  background: #ffffff;
  border: 1px solid #d9d9d9;
  border-radius: 4px;
}

.kdcc-root .kdcc-title {
  font-weight: 600;
}

.kdcc-root .kdcc-status {
  min-height: 20px;
  overflow-wrap: anywhere;
}

.kdcc-root .kdcc-action {
  justify-self: start;
}
