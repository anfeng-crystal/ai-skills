<root>
    <!--示例值：部署前核对 region、appid、queue 和并发度；消费者业务钩子未实现前不要启用。-->
    <region name="fi">
        <!--同一 region 下队列名称不得与标准产品或其他业务冲突。-->
        <queue name="kdcd_sample_queue" appid="gl">
            <!--类路径与配套 Java 一致；若继承模板实现业务，改为实际实现类。并发度须按目标容量确定。-->
            <consumer class="kd.cd.common.snippets.SampleMQConsumer" concurrency="5"/>
        </queue>
        <!--可在此 region 增加其他已实现消费者的 queue；不要配置尚不存在的占位类。-->
    </region>
</root>
